<Window x:Class="NotchFlow.Views.IslandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NotchFlow.Controls" xmlns:views="clr-namespace:NotchFlow.Views" Icon="/NotchFlow;component/Assets/NotchFlow.ico" Title="NotchFlow" Width="440" Height="432" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True">
 <Window.Resources>
  <Geometry x:Key="MusicIcon">M7,17 L7,5 20,2 20,14 M7,8 L20,5 M7,17 C7,21 0,22 1,18 C2,15 7,15 7,17 M20,14 C20,18 13,19 14,15 C15,12 20,12 20,14</Geometry>
  <Geometry x:Key="GearIcon">M9,2 L15,2 16,5 19,6 22,6 24,11 21,13 21,16 22,19 18,23 15,21 12,21 9,23 5,19 6,16 6,13 3,11 5,6 8,5 Z M17,13 A4,4 0 1 1 9,13 A4,4 0 1 1 17,13</Geometry>
<Style x:Key="NavMusic" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Opacity" Value="0.45"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="Music"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="#242426"/></DataTrigger></Style.Triggers></Style><Style x:Key="NavWeather" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Opacity" Value="0.45"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="Weather"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="#242426"/></DataTrigger></Style.Triggers></Style><Style x:Key="NavNotes" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Opacity" Value="0.45"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="Notes"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="#242426"/></DataTrigger></Style.Triggers></Style><Style x:Key="NavTasks" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Opacity" Value="0.45"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="Tasks"><Setter Property="Opacity" Value="1"/><Setter Property="Background" Value="#242426"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <local:IslandSurface x:Name="Capsule" Width="212" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#0B0B0C" CornerRadius="18" BorderBrush="#14FFFFFF" BorderThickness="0.7" MouseEnter="EnterCapsule" MouseLeave="LeaveCapsule" SizeChanged="CapsuleSizeChanged">
   <Grid x:Name="ClipRoot" ClipToBounds="True"><local:LiquidGlassSurface x:Name="GlassLayer"/><local:MediaEffects x:Name="EffectsLayer"/>
    <Grid x:Name="Compact" Width="212" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" MouseLeftButtonDown="OpenClick" Cursor="Hand">
     <Border Width="24" Height="24" CornerRadius="6" Background="#222224" HorizontalAlignment="Left" Margin="6,0,0,0"><Grid><Path Data="{StaticResource MusicIcon}" Stroke="#EFEDE8" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"/><Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/></Border.Background></Border></Grid></Border>
     <StackPanel Width="97" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="39,0,0,0"><TextBlock Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" FontSize="9" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel x:Name="Meter" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"><Border x:Name="Bar0" Width="3" Height="4" CornerRadius="1.5" Background="#EFEDE8" Margin="0,0,3,0"/><Border x:Name="Bar1" Width="3" Height="7" CornerRadius="1.5" Background="#EFEDE8" Margin="0,0,3,0"/><Border x:Name="Bar2" Width="3" Height="5" CornerRadius="1.5" Background="#EFEDE8" Margin="0,0,3,0"/><Border x:Name="Bar3" Width="3" Height="9" CornerRadius="1.5" Background="#EFEDE8"/></StackPanel>
    </Grid>
    <Grid x:Name="ClockCompact" Width="176" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" MouseLeftButtonDown="OpenClick" Cursor="Hand"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding ClockTime}" FontFamily="/NotchFlow;component/Assets/Fonts/#Geist Mono, Consolas" FontSize="16" FontWeight="Medium"/><Border Width="1" Height="13" Background="#45454A" Margin="12,0"/><TextBlock Text="{Binding ClockDate}" FontSize="12" Foreground="#B4B4BB" VerticalAlignment="Center"/></StackPanel></Grid>
    <Grid x:Name="Expanded" Width="400" Height="150" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed">
     <Canvas x:Name="PlayerContent"><Button Canvas.Left="12" Canvas.Top="3" Content="⇄" Click="SourceClick" Width="25" Height="24" Padding="0"/>

      <Border Canvas.Left="22" Canvas.Top="32" Width="74" Height="74" CornerRadius="13" Background="#242426"><Grid><Path Data="{StaticResource MusicIcon}" Stroke="#929294" StrokeThickness="1.7" Width="28" Height="28" Stretch="Uniform"/><Border CornerRadius="13"><Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/></Border.Background></Border></Grid></Border>
      <Border Canvas.Left="78" Canvas.Top="88" Width="27" Height="27" CornerRadius="9" Background="#EFEDE8" BorderBrush="#0B0B0C" BorderThickness="3"><Path Data="{StaticResource MusicIcon}" Stroke="#111113" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"/></Border>
      <StackPanel Canvas.Left="112" Canvas.Top="43" Width="125"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ArtistText" Text="{Binding Artist}" Foreground="#BBBBBE" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      <Button Style="{StaticResource IconButton}" Canvas.Left="259" Canvas.Top="75" Width="36" Height="32" Command="{Binding Previous}" IsEnabled="{Binding CanPrevious}"><Path Data="M10,0 L0,7 10,14 Z M20,0 L10,7 20,14 Z" Fill="#EFEDE8" Width="19" Height="15" Stretch="Uniform"/></Button>
      <Button Style="{StaticResource IconButton}" Canvas.Left="299" Canvas.Top="71" Width="46" Height="36" Command="{Binding Toggle}" IsEnabled="{Binding CanToggle}"><Path x:Name="PlayIcon" Fill="#EFEDE8" Width="20" Height="24" Stretch="Uniform"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M0,0 L19,12 0,24 Z"/><Style.Triggers><DataTrigger Binding="{Binding Playing}" Value="True"><Setter Property="Data" Value="M0,0 L7,0 7,24 0,24 Z M12,0 L19,0 19,24 12,24 Z"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
      <Button Style="{StaticResource IconButton}" Canvas.Left="351" Canvas.Top="75" Width="36" Height="32" Command="{Binding Next}" IsEnabled="{Binding CanNext}"><Path Data="M0,0 L10,7 0,14 Z M10,0 L20,7 10,14 Z" Fill="#EFEDE8" Width="19" Height="15" Stretch="Uniform"/></Button>
      <local:WaveProgress x:Name="ProgressWave" Canvas.Left="22" Canvas.Top="115" Width="356" Height="14" Value="{Binding Progress, Mode=OneWay}"/>
      <TextBlock x:Name="ElapsedText" Canvas.Left="22" Canvas.Top="130" Text="{Binding Elapsed}" FontFamily="/NotchFlow;component/Assets/Fonts/#Geist Mono, Consolas" FontSize="11" Foreground="#A8A8A9"/>
      <TextBlock x:Name="RemainingText" Canvas.Right="22" Canvas.Top="130" Text="{Binding Remaining}" FontFamily="/NotchFlow;component/Assets/Fonts/#Geist Mono, Consolas" FontSize="11" Foreground="#A8A8A9"/>
      <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Canvas.Left="143" Canvas.Top="124" Width="24" Height="22" Click="MuteClick"><Path x:Name="SpeakerPath" Data="M1,8 L5,8 11,3 11,21 5,16 1,16 Z M15,8 Q20,12 15,16 M18,4 Q27,12 18,20" Stroke="#B9B9BC" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"/></Button>
      <Slider x:Name="SystemVolume" Canvas.Left="170" Canvas.Top="125" Width="84" Height="20" Style="{StaticResource VolumeSlider}" ValueChanged="VolumeSliderChanged"/>
     </Canvas>
     <views:WeatherView x:Name="WeatherPane" DataContext="{Binding Weather}" Margin="0,32,0,0" Height="288" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0"/>
     <views:NotesView x:Name="NotesPane" DataContext="{Binding Personal}" Margin="0,32,0,0" Height="358" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0"/>
     <views:TasksView x:Name="TasksPane" DataContext="{Binding Personal}" Margin="0,32,0,0" Height="318" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
      <Button Tag="Music" Style="{StaticResource NavMusic}" Click="SelectTab"><Path Data="{StaticResource MusicIcon}" Stroke="#EFEDE8" StrokeThickness="1.7" Width="15" Height="15" Stretch="Uniform"/></Button>
      <Button Tag="Weather" Style="{StaticResource NavWeather}" Click="SelectTab"><Path Data="M9,3 A6,6 0 1 1 8.9,3 M9,0 L9,1 M0,9 L2,9 M16,2 L15,3 M2,2 L3,3 M16,12 C23,10 25,19 20,20 L8,20 C3,20 3,13 8,13 C8,7 16,7 16,12" Stroke="#EFEDE8" StrokeThickness="1.6" Width="18" Height="17" Stretch="Uniform"/></Button>
      <Button Tag="Notes" Style="{StaticResource NavNotes}" Click="SelectTab"><Path Data="M3,1 L14,1 20,7 20,23 3,23 Z M14,1 L14,7 20,7 M7,11 L16,11 M7,15 L16,15 M7,19 L13,19" Stroke="#EFEDE8" StrokeThickness="1.6" Width="15" Height="17" Stretch="Uniform"/></Button>
      <Button Tag="Tasks" Style="{StaticResource NavTasks}" Click="SelectTab"><Path Data="M1,5 L4,8 9,1 M12,5 L22,5 M1,16 L4,19 9,12 M12,16 L22,16" Stroke="#EFEDE8" StrokeThickness="1.8" Width="17" Height="16" Stretch="Uniform"/></Button>
      <Border Width="1" Height="12" Background="#353537" Margin="7,0"/><Button Style="{StaticResource IconButton}" Click="SettingsClick"><Path Data="{StaticResource GearIcon}" Stroke="#858587" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/></Button>
     </StackPanel>
      <Button x:Name="PinButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,12,0" Click="PinClick"><Path x:Name="PinPath" Data="M8,3 L16,3 15,10 19,14 19,16 5,16 5,14 9,10 Z M12,16 L12,23" Stroke="#858587" StrokeThickness="1.5" Width="14" Height="17" Stretch="Uniform"/></Button>
    </Grid>
    <Grid x:Name="Toast" Width="260" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Path Data="M1,8 L5,8 11,3 11,21 5,16 1,16 Z M15,8 Q20,12 15,16 M18,4 Q27,12 18,20" Stroke="#EFEDE8" StrokeThickness="1.6" Width="17" Height="17" Stretch="Uniform" Margin="8,0,0,0"/><TextBlock x:Name="ToastText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="VolumeBar" Grid.Column="2" Maximum="100" Height="3" Margin="0,0,14,0" Foreground="#EFEDE8" Background="#363638" BorderThickness="0" VerticalAlignment="Center"/></Grid>
   </Grid>
  </local:IslandSurface><local:NeonRibbon x:Name="RibbonLayer" Width="{Binding ActualWidth, ElementName=Capsule}" Height="{Binding ActualHeight, ElementName=Capsule}" LayoutTransform="{Binding LayoutTransform, ElementName=Capsule}" Margin="{Binding Margin, ElementName=Capsule}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
 </Grid>
</Window>






