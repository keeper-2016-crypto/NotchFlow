<Window x:Class="NotchFlow.Views.ColorPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Выбор цвета · NotchFlow" Width="360" Height="680" ResizeMode="NoResize" Background="#0B0B0C" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ToolTipService.IsEnabled="False">
 <DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8"><Button Content="Отмена" IsCancel="True"/><Button x:Name="Confirm" Content="Применить" IsDefault="True" Click="ConfirmClick"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
  <TextBlock Text="Выбор цвета" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/>
  <Grid x:Name="Palette" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" ClipToBounds="True" MouseLeftButtonDown="PaletteDown" MouseMove="PaletteMove" MouseLeftButtonUp="PaletteUp" SizeChanged="PaletteSizeChanged">
   <Border x:Name="HueSurface" Background="Red"/>
   <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.Background></Border>
   <Canvas IsHitTestVisible="False"><Ellipse x:Name="Marker" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent"><Ellipse.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Color="Black"/></Ellipse.Effect></Ellipse></Canvas>
  </Grid>
  <TextBlock Text="Оттенок" Margin="0,12,0,4"/>
  <Grid Height="26"><Border Height="12" CornerRadius="6"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.1667"/><GradientStop Color="Lime" Offset="0.3333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.6667"/><GradientStop Color="Magenta" Offset="0.8333"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Border.Background></Border><Slider IsMoveToPointEnabled="True" x:Name="Hue" Minimum="0" Maximum="360" ValueChanged="HueChanged" Background="Transparent"><Slider.Template><ControlTemplate TargetType="Slider"><Track x:Name="PART_Track"><Track.Thumb><Thumb Width="8"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#DDFFFFFF" BorderBrush="#333333" BorderThickness="1" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Slider.Template></Slider></Grid>
  <UniformGrid Columns="2" Margin="0,12,0,8"><StackPanel Margin="0,0,5,0"><TextBlock Text="Текущий"/><Border x:Name="Before" Height="30" CornerRadius="5" Margin="0,5" BorderBrush="#777777" BorderThickness="1"/></StackPanel><StackPanel Margin="5,0,0,0"><TextBlock Text="Новый"/><Border x:Name="After" Height="30" CornerRadius="5" Margin="0,5" BorderBrush="#777777" BorderThickness="1"/></StackPanel></UniformGrid>
  <TextBlock Text="Цвет, HEX"/><TextBox x:Name="HexInput" TextChanged="HexChanged" Background="#202022" Foreground="White" BorderBrush="#49494E" Padding="8"/>
  <TextBlock x:Name="Error" Foreground="#FFAAAA" TextWrapping="Wrap" FontSize="11"/>
  <UniformGrid x:Name="Presets" Columns="8" Margin="0,8"/>

 </StackPanel></ScrollViewer></DockPanel>
</Window>
