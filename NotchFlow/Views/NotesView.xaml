<UserControl x:Class="NotchFlow.Views.NotesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style TargetType="TextBox"><Setter Property="Background" Value="#1B1B1E"/><Setter Property="Foreground" Value="#EFEDE8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9"/><Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#556577"/></Style></UserControl.Resources>
 <Grid Margin="22,7,22,18"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button Content="+" Click="AddNote" DockPanel.Dock="Right" ToolTip="Создать заметку" IsEnabled="{Binding CanEdit}" Width="30" Padding="0" Margin="0"/><TextBlock Text="Заметки" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
  <Grid x:Name="NoteContent" Grid.Row="1" Margin="0,8,0,8">
   <Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding EditingNote}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <TextBlock Text="Пока нет заметок. Нажмите +, чтобы создать первую." TextWrapping="Wrap" Foreground="#929298" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NoNotes}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="#1B1B1E" CornerRadius="9" Padding="10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#2A2A2E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Text}" Foreground="#96969D" FontSize="11" MaxHeight="30" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/><TextBlock Text="{Binding UpdatedAt, StringFormat=Изменена {0:dd.MM.yyyy HH:mm}}" Foreground="#707077" FontSize="9" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
   <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EditingNote}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Button Content="Удалить" Click="DeleteNote" IsEnabled="{Binding CanEdit}" DockPanel.Dock="Right" Padding="7,3" Margin="0" FontSize="10"/><Button Content="‹  Все заметки" Click="Back" HorizontalAlignment="Left" Padding="0" Background="Transparent" FontSize="11"/></DockPanel>
    <TextBox Grid.Row="1" Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" IsEnabled="{Binding CanEdit}" ToolTip="Заголовок"/>
    <TextBox Grid.Row="2" Text="{Binding SelectedNote.Text, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,7,0,5" ToolTip="Текст заметки"/>
    <TextBlock Grid.Row="3" Text="{Binding NoteDates}" FontSize="9" Foreground="#777780" TextWrapping="Wrap"/>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2"><Button DockPanel.Dock="Right" Content="Сохранить" Click="Save" FontSize="10" Padding="7,3" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding DisplayError}" FontSize="10" Foreground="#9D9DA5" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</UserControl>


