<TextBox Text="{Binding WeatherCity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="По умолчанию — Пятигорск. Поиск города выполняется после применения настроек." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
<Border BorderBrush="#29292D" BorderThickness="0,1,0,0" Margin="0,20,0,12" Padding="0,14,0,0">
<TextBlock Text="Прогноз" FontSize="18" FontWeight="SemiBold"/>
</Border>
<TextBlock Text="Температура отображается в градусах Цельсия. Обновление — раз в 20 минут после открытия погоды; также доступно ручное обновление. Данные предоставляет Open-Meteo." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="Файлы"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,16"><TextBlock Text="Файлы" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/><CheckBox IsChecked="{Binding FileShelfEnabled, UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="Включить полку файлов" TextWrapping="Wrap"/></CheckBox><TextBlock Text="Перетаскивайте файлы и папки на остров. Полка хранит ссылки: оригиналы не копируются и не удаляются. Для передачи обратно используйте Ctrl — копировать, Shift — переместить; действие выполняет принимающая программа." TextWrapping="Wrap" Foreground="#B4B4BF" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Системные уведомления"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,16"><TextBlock Text="Системные уведомления" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/><CheckBox IsChecked="{Binding CapsLockNotifications, UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="Показывать Caps Lock" TextWrapping="Wrap"/></CheckBox><CheckBox IsChecked="{Binding NumLockNotifications, UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="Показывать Num Lock" TextWrapping="Wrap"/></CheckBox><TextBlock Text="Длительность уведомления, мс" Margin="0,12,0,0"/><Slider Minimum="1000" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding KeyboardNotificationMs, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding KeyboardNotificationMs}"/><CheckBox IsChecked="{Binding KeyboardNotificationAnimations, UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="Анимации уведомлений" TextWrapping="Wrap"/></CheckBox></StackPanel></ScrollViewer></TabItem><TabItem Header="Мониторинг системы"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,16"><TextBlock Text="Мониторинг системы" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/><CheckBox IsChecked="{Binding SystemMonitorEnabled, UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="Включить мониторинг" TextWrapping="Wrap"/></CheckBox><CheckBox IsChecked="{Binding MonitorCpu, UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="Показывать CPU" TextWrapping="Wrap"/></CheckBox><CheckBox IsChecked="{Binding MonitorGpu, UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="Показывать GPU" TextWrapping="Wrap"/></CheckBox><CheckBox IsChecked="{Binding MonitorRam, UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="Показывать RAM" TextWrapping="Wrap"/></CheckBox><TextBlock Text="Интервал обновления" Margin="0,12,0,0"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding MonitorIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Tag="1" Content="1 секунда"/><ComboBoxItem Tag="2" Content="2 секунды"/><ComboBoxItem Tag="5" Content="5 секунд"/></ComboBox><TextBlock Text="Показатель компактного острова"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding CompactSystemMetric, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Tag="None" Content="Ничего не показывать"/><ComboBoxItem Tag="CPU" Content="CPU"/><ComboBoxItem Tag="GPU" Content="GPU"/><ComboBoxItem Tag="RAM" Content="RAM"/><ComboBoxItem Tag="Auto" Content="Автоматическая смена"/></ComboBox><CheckBox IsChecked="{Binding MonitorGraphs, UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="Мини-график истории CPU" TextWrapping="Wrap"/></CheckBox><TextBlock Text="Музыка имеет приоритет. После паузы сохраняется обычная задержка перехода к часам; затем может появиться выбранный показатель. Когда данные не видны, сбор приостанавливается. GPU: самый загруженный движок, без суммирования разных адаптеров." TextWrapping="Wrap" Foreground="#B4B4BF" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem><TabItem Header="О приложении">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
