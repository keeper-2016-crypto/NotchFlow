<Window x:Class="NotchFlow.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NotchFlow.Controls" Icon="/NotchFlow;component/Assets/NotchFlow.ico" Title="NotchFlow · Настройки" Width="860" Height="680" MinWidth="620" MinHeight="420" Background="#0B0B0C" WindowStartupLocation="CenterScreen" ToolTipService.IsEnabled="False">
<Window.Resources>
  <Style TargetType="TextBox">
<Setter Property="Background" Value="#202022"/>
<Setter Property="Foreground" Value="#EFEDE8"/>
<Setter Property="BorderBrush" Value="#39393C"/>
<Setter Property="Padding" Value="9,6"/>
<Setter Property="Margin" Value="0,5,0,10"/>
</Style>
  <Style TargetType="ComboBox">
<Setter Property="Foreground" Value="#EFEDE8"/>
<Setter Property="Margin" Value="0,6,0,14"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="ComboBox">
<Grid>
<Border Background="#202022" BorderBrush="#39393C" BorderThickness="1" CornerRadius="6">
<ContentPresenter Margin="10,7,30,7" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
</Border>
<ToggleButton Background="Transparent" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
<ToggleButton.Template>
<ControlTemplate TargetType="ToggleButton">
<Grid Background="Transparent">
<TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
</Grid>
</ControlTemplate>
</ToggleButton.Template>
</ToggleButton>
<Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
<Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#202022" BorderBrush="#454548" BorderThickness="1" Padding="4" CornerRadius="6">
<ScrollViewer MaxHeight="220">
<ItemsPresenter/>
</ScrollViewer>
</Border>
</Popup>
</Grid>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>

  <Style TargetType="TabItem">
<Setter Property="Foreground" Value="#B1B1B4"/>
<Setter Property="HorizontalContentAlignment" Value="Left"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="TabItem">
<Border x:Name="Item" Background="Transparent" CornerRadius="6" Margin="0,2" Padding="12,11">
<ContentPresenter ContentSource="Header"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsSelected" Value="True">
<Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsAccentTint}"/>
<Setter Property="Foreground" Value="#EFEDE8"/>
</Trigger>
<Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="Item" Property="Background" Value="#19191B"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
  <Style TargetType="TabControl">
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="TabControl">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="180"/>
<ColumnDefinition/>
</Grid.ColumnDefinitions>
<Border BorderBrush="#232325" BorderThickness="0,0,1,0" Padding="0,0,14,0">
<StackPanel>
<TextBlock Text="NotchFlow" FontSize="19" FontWeight="SemiBold" Margin="12,2,0,24"/>
<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320"><TabPanel IsItemsHost="True"/></ScrollViewer>
</StackPanel>
</Border>
<ContentPresenter Grid.Column="1" Margin="24,0,0,0" ContentSource="SelectedContent"/>
</Grid>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
 <Style TargetType="Slider" BasedOn="{StaticResource VolumeSlider}">
<Setter Property="Focusable" Value="True"/>
<Setter Property="Height" Value="28"/>
<Setter Property="Margin" Value="0,4,0,12"/>
</Style>
<Style TargetType="CheckBox">
<Setter Property="Foreground" Value="#EFEDE8"/>
<Setter Property="Margin" Value="0,8"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="CheckBox">
<Grid Background="Transparent">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="44"/>
<ColumnDefinition/>
</Grid.ColumnDefinitions>
<Border x:Name="Rail" Width="34" Height="20" CornerRadius="10" Background="#36363C" HorizontalAlignment="Left" VerticalAlignment="Center">
<Ellipse x:Name="Dot" Width="14" Height="14" Fill="#D4D4D8" HorizontalAlignment="Left" Margin="3"/>
</Border>
<ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
</Grid>
<ControlTemplate.Triggers>
<Trigger Property="IsChecked" Value="True">
<Setter TargetName="Rail" Property="Background" Value="{DynamicResource SettingsAccent}"/>
<Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
</Trigger>
<Trigger Property="IsEnabled" Value="False">
<Setter Property="Opacity" Value="0.4"/>
</Trigger>
<Trigger Property="IsKeyboardFocused" Value="True">
<Setter TargetName="Rail" Property="BorderBrush" Value="White"/>
<Setter TargetName="Rail" Property="BorderThickness" Value="1"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
</Window.Resources>
<DockPanel Margin="20">
<StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
<TextBlock x:Name="ErrorText" Foreground="#FFAAAA" TextWrapping="Wrap"/>
<TextBlock Text="Изменения вступают в силу после применения и сохраняются для следующего запуска." Foreground="#A1A1AA" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,8"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
<Button Content="Отмена" IsCancel="True" Click="CancelClick"/>
<Button x:Name="ApplyButton" Content="Применить" Click="ApplyClick"/>
<Button x:Name="SaveButton" Content="Сохранить" Click="SaveClick" Background="{DynamicResource SettingsAccentTint}"/>
</StackPanel>
</StackPanel>
<TabControl x:Name="Categories" TabStripPlacement="Left">
<TabItem Header="Общие">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="0,0,16,16">
<TextBlock Text="Общие" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16"/>
<CheckBox IsChecked="{Binding AutoStart, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Запускать вместе с Windows" TextWrapping="Wrap"/>
</CheckBox>
<CheckBox IsChecked="{Binding AlwaysOnTop, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Поверх всех окон" TextWrapping="Wrap"/>
</CheckBox>
<CheckBox IsChecked="{Binding CollapseOnLeave, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Автоматически сворачивать остров" TextWrapping="Wrap"/>
</CheckBox>
<TextBlock Text="Сворачивает панель, когда курсор покидает её область." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
<CheckBox IsChecked="{Binding StartCollapsed, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Запускать остров свёрнутым" TextWrapping="Wrap"/>
</CheckBox>
<CheckBox IsChecked="{Binding VolumeEnabled, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Показывать изменения громкости" TextWrapping="Wrap"/>
</CheckBox>
<Border BorderBrush="#29292D" BorderThickness="0,1,0,0" Margin="0,20,0,12" Padding="0,14,0,0"><TextBlock Text="Обновления" FontSize="18" FontWeight="SemiBold"/></Border>
<TextBlock Text="{Binding Updates.CurrentVersion, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=Установленная версия: {0}}"/>
<CheckBox x:Name="AutoUpdatesBox" IsChecked="{Binding AutoCheckUpdates}"><TextBlock Text="Автоматически проверять обновления" TextWrapping="Wrap"/></CheckBox>
<CheckBox IsChecked="{Binding CheckUpdatesAtStartup}" IsEnabled="{Binding IsChecked, ElementName=AutoUpdatesBox}"><TextBlock Text="Проверять обновления при запуске" TextWrapping="Wrap"/></CheckBox>
<TextBlock Text="Фоновая проверка — не чаще одного раза в 12 часов. Установка выполняется только с вашего согласия." Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,5,0,12"/>
<TextBlock Text="Последняя успешная проверка"/>
<TextBlock Text="{Binding Updates.LastSuccess, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Ещё не было}" Foreground="#A1A1AA"/>
<TextBlock Text="{Binding Updates.Status, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Проверка доступна в запущенном приложении}" TextWrapping="Wrap" Margin="0,10"/>
<Button Content="Проверить обновления" Click="CheckUpdatesClick" HorizontalAlignment="Left" IsEnabled="{Binding Updates.IsAvailable, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}"/>
<Button Content="Открыть страницу релизов" Tag="https://github.com/keeper-2016-crypto/NotchFlow/releases" Click="OpenLinkClick" HorizontalAlignment="Left"/>
<Border BorderBrush="#29292D" BorderThickness="0,1,0,0" Margin="0,20,0,12" Padding="0,14,0,0">
<TextBlock Text="Системный трей" FontSize="18" FontWeight="SemiBold"/>
</Border>
<TextBlock Text="NotchFlow работает в системном трее. Оттуда можно открыть настройки или полностью выйти из приложения." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="Внешний вид">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="0,0,16,16">
<TextBlock Text="Внешний вид" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16"/>
<TextBlock Text="Эффект фона" TextWrapping="Wrap"/>
<ComboBox x:Name="BackgroundEffectBox" SelectedValuePath="Tag" SelectedValue="{Binding BackgroundEffect, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<ComboBoxItem Tag="Solid" Content="Обычный"/>
<ComboBoxItem Tag="Liquid Glass" Content="Liquid Glass — прозрачное стекло"/>
<ComboBoxItem Tag="Album Gradient" Content="Градиент обложки"/>
<ComboBoxItem Visibility="Collapsed" IsEnabled="False" Tag="Acrylic Glass" Content="Acrylic — совместимый непрозрачный фон"/>
</ComboBox>
<StackPanel>
<StackPanel.Style>
<Style TargetType="StackPanel">
<Setter Property="Visibility" Value="Collapsed"/>
<Style.Triggers>
<DataTrigger Binding="{Binding SelectedValue, ElementName=BackgroundEffectBox}" Value="Liquid Glass">
<Setter Property="Visibility" Value="Visible"/>
</DataTrigger>
</Style.Triggers>
</Style>
</StackPanel.Style>
<Border BorderBrush="#29292D" BorderThickness="0,1,0,0" Margin="0,20,0,12" Padding="0,14,0,0">
<TextBlock Text="Стеклянные эффекты" FontSize="18" FontWeight="SemiBold"/>
</Border>
<TextBlock Text="Плотность тонировки" TextWrapping="Wrap"/>
<Slider x:Name="GlassOpacitySlider" Minimum="0" Maximum="1" Value="{Binding GlassOpacity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="{Binding Value, ElementName=GlassOpacitySlider, StringFormat={}{0:0.##}}" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>
<TextBlock Text="Меняет прозрачность стекла, не затрагивая текст и кнопки." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
<TextBlock Text="Тонировка" TextWrapping="Wrap"/>
<ComboBox x:Name="GlassTintBox" SelectedValuePath="Tag" SelectedValue="{Binding GlassTint, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<ComboBoxItem Tag="Dark" Content="Тёмная"/>
<ComboBoxItem Tag="Neutral" Content="Нейтральная"/>
<ComboBoxItem Tag="Album Color" Content="В цветах обложки"/>
<ComboBoxItem Tag="Custom" Content="Свой цвет"/>
</ComboBox>
<StackPanel>
<StackPanel.Style>
<Style TargetType="StackPanel">
<Setter Property="Visibility" Value="Collapsed"/>
<Style.Triggers>
<DataTrigger Binding="{Binding SelectedValue, ElementName=GlassTintBox}" Value="Custom">
<Setter Property="Visibility" Value="Visible"/>
</DataTrigger>
</Style.Triggers>
</Style>
</StackPanel.Style>
<TextBlock Text="Цвет стекла, HEX" TextWrapping="Wrap"/>
<local:ColorField Value="{Binding GlassCustomTint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
</StackPanel>
<TextBlock Text="Интенсивность отражений" TextWrapping="Wrap"/>
<ComboBox x:Name="GlassReflectionBox" SelectedValuePath="Tag" SelectedValue="{Binding GlassReflection, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<ComboBoxItem Tag="Off" Content="Выключены"/>
<ComboBoxItem Tag="Low" Content="Низкая"/>
<ComboBoxItem Tag="Medium" Content="Средняя"/>
<ComboBoxItem Tag="High" Content="Высокая"/>
</ComboBox>
<CheckBox IsChecked="{Binding GlassEdgeHighlight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Подсветка краёв" TextWrapping="Wrap"/>
</CheckBox>
<CheckBox IsChecked="{Binding GlassDynamicLighting, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Динамическое освещение" TextWrapping="Wrap"/>
</CheckBox>
<CheckBox IsChecked="{Binding GlassBackdropBlur, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Размывать фон за островом" TextWrapping="Wrap"/>
</CheckBox>
<TextBlock Text="Windows может отключать размытие при энергосбережении или отключённой прозрачности." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
</StackPanel>
<StackPanel>
<StackPanel.Style>
<Style TargetType="StackPanel">
<Setter Property="Visibility" Value="Collapsed"/>
<Style.Triggers>
<DataTrigger Binding="{Binding SelectedValue, ElementName=BackgroundEffectBox}" Value="Solid">
<Setter Property="Visibility" Value="Visible"/>
</DataTrigger>
</Style.Triggers>
</Style>
</StackPanel.Style>
</StackPanel>
<StackPanel>
<StackPanel.Style>
<Style TargetType="StackPanel">
<Setter Property="Visibility" Value="Collapsed"/>
<Style.Triggers>
<DataTrigger Binding="{Binding SelectedValue, ElementName=BackgroundEffectBox}" Value="Album Gradient">
<Setter Property="Visibility" Value="Visible"/>
</DataTrigger>
</Style.Triggers>
</Style>
</StackPanel.Style>
<TextBlock Text="Интенсивность тонировки градиента" TextWrapping="Wrap"/>
<Slider x:Name="TintIntensitySlider" Minimum="0" Maximum="1" Value="{Binding TintIntensity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="{Binding Value, ElementName=TintIntensitySlider, StringFormat={}{0:0.##}}" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>
</StackPanel>
<StackPanel>
<StackPanel.Style>
<Style TargetType="StackPanel">
<Setter Property="Visibility" Value="Collapsed"/>
<Style.Triggers>
<DataTrigger Binding="{Binding SelectedValue, ElementName=BackgroundEffectBox}" Value="Acrylic Glass">
<Setter Property="Visibility" Value="Visible"/>
</DataTrigger>
</Style.Triggers>
</Style>
</StackPanel.Style>
<TextBlock Text="В этой версии отдельный эффект Acrylic не реализован. Сохранён совместимый фон старых настроек. Для размытия выберите Liquid Glass." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
</StackPanel>
<StackPanel>
<StackPanel.Style>
<Style TargetType="StackPanel">
<Style.Triggers>
<DataTrigger Binding="{Binding SelectedValue, ElementName=BackgroundEffectBox}" Value="Liquid Glass">
<Setter Property="Visibility" Value="Collapsed"/>
</DataTrigger>
</Style.Triggers>
</Style>
</StackPanel.Style>
<TextBlock Text="Цвет поверхности, HEX"/>
<local:ColorField Value="{Binding CapsuleColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
<TextBlock Text="Непрозрачность поверхности"/>
<Slider Minimum="0.3" Maximum="1" Value="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}"/>
</StackPanel>
<TextBlock Text="Подсветка контура" TextWrapping="Wrap"/>
<Slider x:Name="BorderGlowSlider" Minimum="0" Maximum="1" Value="{Binding BorderGlow, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="{Binding Value, ElementName=BorderGlowSlider, StringFormat={}{0:0.##}}" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>
<CheckBox IsChecked="{Binding Shadow, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Мягкая тень" TextWrapping="Wrap"/>
</CheckBox>
<Border BorderBrush="#29292D" BorderThickness="0,1,0,0" Margin="0,20,0,12" Padding="0,14,0,0">
<TextBlock Text="Анимации" FontSize="18" FontWeight="SemiBold"/>
</Border>
<CheckBox IsChecked="{Binding Animations, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Включить анимации" TextWrapping="Wrap"/>
</CheckBox>
<CheckBox IsChecked="{Binding ReduceMotion, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Уменьшить движение" TextWrapping="Wrap"/>
</CheckBox>
<TextBlock Text="Длительность перехода, мс" TextWrapping="Wrap"/>
<Slider x:Name="AnimationMsSlider" Minimum="150" Maximum="300" Value="{Binding AnimationMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="{Binding Value, ElementName=AnimationMsSlider, StringFormat={}{0:0.##}}" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>

<Border BorderBrush="#29292D" BorderThickness="0,1,0,0" Margin="0,20,0,12" Padding="0,14,0,0">
<TextBlock Text="Геометрия и расположение" FontSize="18" FontWeight="SemiBold"/>
</Border>
<CheckBox IsChecked="{Binding AttachToTop, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Форма Notch — у верхней кромки" TextWrapping="Wrap"/>
</CheckBox>
<CheckBox x:Name="AdaptiveWidthToggle" Content="Адаптивная ширина компактного плеера" IsChecked="{Binding AdaptiveMusicWidth}"/>
<StackPanel IsEnabled="{Binding IsChecked, ElementName=AdaptiveWidthToggle}">
<TextBlock Text="{Binding MinimumMusicWidth, StringFormat='Минимальная ширина · {0}'}"/>
<Slider Minimum="80" Maximum="240" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MinimumMusicWidth}"/>
<TextBlock Text="{Binding MaximumMusicWidth, StringFormat='Максимальная ширина · {0}'}"/>
<Slider Minimum="180" Maximum="400" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaximumMusicWidth}"/>
<CheckBox Content="Плавное изменение ширины" IsChecked="{Binding AnimateMusicWidth}"/>
</StackPanel>
<TextBlock Text="Масштаб острова" TextWrapping="Wrap"/>
<Slider x:Name="ScaleSlider" Minimum="0.8" Maximum="1.8" Value="{Binding Scale, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:0.##}}" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>
<TextBlock Text="Скругление раскрытой панели" TextWrapping="Wrap"/>
<Slider x:Name="CornerRadiusSlider" Minimum="8" Maximum="40" Value="{Binding CornerRadius, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="{Binding Value, ElementName=CornerRadiusSlider, StringFormat={}{0:0.##}}" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>
<TextBlock Text="Монитор" TextWrapping="Wrap"/>
<ComboBox x:Name="MonitorBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Monitor, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="Положение" TextWrapping="Wrap"/>
<ComboBox x:Name="PositionBox" SelectedValuePath="Tag" SelectedValue="{Binding Position, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<ComboBoxItem Tag="Center" Content="Сверху по центру"/>
<ComboBoxItem Tag="Left" Content="Сверху слева"/>
<ComboBoxItem Tag="Right" Content="Сверху справа"/>
</ComboBox>
<TextBlock Text="Смещение по горизонтали" TextWrapping="Wrap"/>
<TextBox Text="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="Отступ от верхнего края" TextWrapping="Wrap"/>
<TextBox Text="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="Отступ сверху применяется к плавающему острову. При отключении выбранного монитора используется основной." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
<Button Content="Сбросить оформление" Click="ResetAppearanceClick" HorizontalAlignment="Left" Margin="0,16,0,0"/>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="Медиаплеер">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="0,0,16,16">
<TextBlock Text="Медиаплеер" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16"/>
<CheckBox IsChecked="{Binding MediaEnabled, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Включить медиаплеер" TextWrapping="Wrap"/>
</CheckBox>
<TextBlock Text="Источник музыки выбирается кнопкой переключения сессии на острове." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
<Border BorderBrush="#29292D" BorderThickness="0,1,0,0" Margin="0,20,0,12" Padding="0,14,0,0">
<TextBlock Text="Визуализатор" FontSize="18" FontWeight="SemiBold"/>
</Border>
<TextBlock Text="Стиль визуализатора" TextWrapping="Wrap"/>
<ComboBox x:Name="MediaVisualizerBox" SelectedValuePath="Tag" SelectedValue="{Binding MediaVisualizer, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<ComboBoxItem Tag="Classic" Content="Классический"/>


<ComboBoxItem Tag="Equalizer" Content="Эквалайзер"/>
<ComboBoxItem Tag="Radial Pulse" Content="Radial Pulse"/>
<ComboBoxItem Tag="Spectrum Floor" Content="Spectrum Floor"/>

</ComboBox>
<StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedValue, ElementName=MediaVisualizerBox}" Value="Spectrum Floor"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Чувствительность, %"/><Slider Minimum="0" Maximum="100" Value="{Binding FloorSensitivity}"/>
<TextBlock Text="Плавность, %"/><Slider Minimum="0" Maximum="100" Value="{Binding FloorSmooth}"/>
<TextBlock Text="Непрозрачность, %"/><Slider Minimum="0" Maximum="100" Value="{Binding FloorOpacity}"/>
<TextBlock Text="Максимальная высота, %"/><Slider Minimum="10" Maximum="100" Value="{Binding FloorHeight}"/>
<TextBlock Text="Свечение, %"/><Slider Minimum="0" Maximum="100" Value="{Binding FloorGlow}"/>
<TextBlock Text="Ширина столбиков, %"/><Slider Minimum="20" Maximum="100" Value="{Binding FloorWidth}"/>
<TextBlock Text="Количество столбиков"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding FloorBars}"><ComboBoxItem Tag="0" Content="Авто"/><ComboBoxItem Tag="16" Content="16"/><ComboBoxItem Tag="24" Content="24"/><ComboBoxItem Tag="32" Content="32"/><ComboBoxItem Tag="48" Content="48"/><ComboBoxItem Tag="64" Content="64"/></ComboBox><TextBlock Text="Источник цвета"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding FloorColor}"><ComboBoxItem Tag="Accent" Content="Акцент"/><ComboBoxItem Tag="Album" Content="Обложка"/><ComboBoxItem Tag="Custom" Content="Свой цвет"/></ComboBox><local:ColorField Value="{Binding FloorHex, Mode=TwoWay}"/><CheckBox Content="Показывать также в компактном острове" IsChecked="{Binding FloorCompact}"/><Button Content="Сбросить настройки Spectrum Floor" Click="ResetFloorClick"/></StackPanel>
<StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedValue, ElementName=MediaVisualizerBox}" Value="Radial Pulse"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Чувствительность, %"/><Slider Minimum="0" Maximum="100" Value="{Binding RadialSensitivity}"/>
<TextBlock Text="Плавность, %"/><Slider Minimum="0" Maximum="100" Value="{Binding RadialSmooth}"/>
<TextBlock Text="Непрозрачность, %"/><Slider Minimum="0" Maximum="100" Value="{Binding RadialOpacity}"/>
<TextBlock Text="Длина сегментов, %"/><Slider Minimum="10" Maximum="100" Value="{Binding RadialLength}"/>
<TextBlock Text="Толщина сегментов"/><Slider Minimum="0.5" Maximum="3" Value="{Binding RadialThickness}"/>
<TextBlock Text="Свечение, %"/><Slider Minimum="0" Maximum="100" Value="{Binding RadialGlow}"/>
<TextBlock Text="Отступ от обложки"/><Slider Minimum="1" Maximum="8" Value="{Binding RadialGap}"/>
<TextBlock Text="Пульсация обложки, %"/><Slider Minimum="0" Maximum="100" Value="{Binding RadialBassAmount}"/>
<TextBlock Text="Количество сегментов"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RadialSegments}"><ComboBoxItem Tag="0" Content="Авто"/><ComboBoxItem Tag="24" Content="24"/><ComboBoxItem Tag="32" Content="32"/><ComboBoxItem Tag="48" Content="48"/><ComboBoxItem Tag="64" Content="64"/></ComboBox><TextBlock Text="Источник цвета"/><ComboBox x:Name="RadialSource" SelectedValuePath="Tag" SelectedValue="{Binding RadialColor}"><ComboBoxItem Tag="Palette" Content="Палитра обложки"/><ComboBoxItem Tag="Accent" Content="Акцент"/><ComboBoxItem Tag="Album" Content="Обложка"/><ComboBoxItem Tag="Custom" Content="Свой цвет"/></ComboBox><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedValue, ElementName=RadialSource}" Value="Palette"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Распределение палитры"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RadialDistribution}"><ComboBoxItem Tag="Alternate" Content="Чередование"/><ComboBoxItem Tag="Gradient" Content="Круговой градиент"/><ComboBoxItem Tag="Zones" Content="Частотные зоны"/></ComboBox><TextBlock Text="Количество цветов"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RadialColors}"><ComboBoxItem Tag="0" Content="Авто"/><ComboBoxItem Tag="2" Content="2"/><ComboBoxItem Tag="3" Content="3"/><ComboBoxItem Tag="4" Content="4"/><ComboBoxItem Tag="5" Content="5"/></ComboBox><TextBlock Text="Насыщенность палитры"/><Slider Minimum="0" Maximum="160" Value="{Binding RadialSaturation}"/></StackPanel><TextBlock Text="Отображение"/><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RadialMode}"><ComboBoxItem Tag="Both" Content="Оба режима"/><ComboBoxItem Tag="Compact" Content="Компактный"/><ComboBoxItem Tag="Expanded" Content="Раскрытый"/></ComboBox><local:ColorField Value="{Binding RadialHex, Mode=TwoWay}"/><CheckBox Content="Зеркальное распределение частот" IsChecked="{Binding RadialMirror}"/><CheckBox Content="Пульсация обложки в такт басам" IsChecked="{Binding RadialBass}"/><Button Content="Сбросить настройки Radial Pulse" Click="ResetRadialClick"/></StackPanel>
<CheckBox x:Name="AudioAnalysisBox" IsChecked="{Binding AudioAnalysisEnabled, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<TextBlock Text="Анализировать системный звук" TextWrapping="Wrap"/>
</CheckBox>
<TextBlock Text="Визуализаторы реагируют на звук всех приложений, включая уведомления. Аудио обрабатывается в памяти и не записывается." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
<StackPanel>
<StackPanel.Style>
<Style TargetType="StackPanel">
<Setter Property="Visibility" Value="Collapsed"/>
<Style.Triggers>
<DataTrigger Binding="{Binding IsChecked, ElementName=AudioAnalysisBox}" Value="True">
<Setter Property="Visibility" Value="Visible"/>
</DataTrigger>
</Style.Triggers>
</Style>
</StackPanel.Style>
<TextBlock Text="Чувствительность к звуку" TextWrapping="Wrap"/>
<Slider x:Name="AudioSensitivitySlider" Minimum="0.25" Maximum="4" Value="{Binding AudioSensitivity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
<TextBlock Text="{Binding Value, ElementName=AudioSensitivitySlider, StringFormat={}{0:0.##}}" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,8"/>
</StackPanel>
<TextBlock Text="Без анализа звука аудиореактивные эффекты остаются неподвижными." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
<Border BorderBrush="#29292D" BorderThickness="0,1,0,0" Margin="0,20,0,12" Padding="0,14,0,0">
<TextBlock Text="Цвета медиаплеера" FontSize="18" FontWeight="SemiBold"/>
</Border>
<TextBlock Text="Акцентный цвет" TextWrapping="Wrap"/>
<ComboBox x:Name="AccentModeBox" SelectedValuePath="Tag" SelectedValue="{Binding AccentMode, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<ComboBoxItem Tag="Default White" Content="Белый"/>
<ComboBoxItem Tag="Red" Content="Красный"/>
<ComboBoxItem Tag="Purple" Content="Фиолетовый"/>
<ComboBoxItem Tag="Blue" Content="Синий"/>
<ComboBoxItem Tag="Cyan" Content="Голубой"/>
<ComboBoxItem Tag="Green" Content="Зелёный"/>
<ComboBoxItem Tag="Pink" Content="Розовый"/>
<ComboBoxItem Tag="Custom HEX" Content="Свой цвет"/>
<ComboBoxItem Tag="Dynamic Album Colors" Content="Цвета обложки"/>
</ComboBox>
<StackPanel>
<StackPanel.Style>
<Style TargetType="StackPanel">
<Setter Property="Visibility" Value="Collapsed"/>
<Style.Triggers>
<DataTrigger Binding="{Binding SelectedValue, ElementName=AccentModeBox}" Value="Custom HEX">
<Setter Property="Visibility" Value="Visible"/>
</DataTrigger>

</Style.Triggers>
</Style>
</StackPanel.Style>
<TextBlock Text="Свой акцент, HEX" TextWrapping="Wrap"/>
<local:ColorField Value="{Binding CustomAccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
<TextBlock Text="Применяется к медиаплееру и эквалайзеру." TextWrapping="Wrap" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,12"/>
</StackPanel>
<Border BorderBrush="#29292D" BorderThickness="0,1,0,0" Margin="0,20,0,12" Padding="0,14,0,0">
<TextBlock Text="Обложка" FontSize="18" FontWeight="SemiBold"/>
</Border>
<TextBlock Text="Стиль обложки" TextWrapping="Wrap"/>
<ComboBox x:Name="AlbumArtStyleBox" SelectedValuePath="Tag" SelectedValue="{Binding AlbumArtStyle, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
<ComboBoxItem Tag="Clean" Content="Обычная"/>
<ComboBoxItem Tag="Blurred" Content="Размытая"/>
<ComboBoxItem Tag="Gradient" Content="Градиентная"/>
<ComboBoxItem Tag="Blur + Gradient" Content="Размытие и градиент"/>
</ComboBox>
</StackPanel>
</ScrollViewer>
</TabItem>
<TabItem Header="Погода">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="0,0,16,16">
