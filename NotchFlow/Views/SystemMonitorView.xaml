<UserControl x:Name="Panel" x:Class="NotchFlow.Views.SystemMonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><UniformGrid Margin="15,7,15,4" Rows="1"><StackPanel x:Name="CpuCard" Margin="4,0">
 <StackPanel Orientation="Horizontal"><Path Data="{StaticResource MetricCpuIcon}" Width="15" Height="13" Stretch="Uniform" Stroke="#BABAC2" StrokeThickness="1.2" VerticalAlignment="Center" AutomationProperties.Name="CPU"/><TextBlock Text="{Binding CpuText}" FontSize="14" FontWeight="SemiBold" Margin="5,0"/></StackPanel>
 <StackPanel x:Name="CpuLine"><TextBlock Text="100%" HorizontalAlignment="Right" FontSize="8" Foreground="#A1A1AA"/>
 <Border BorderThickness="1" BorderBrush="#55555B"><Grid Height="50" ClipToBounds="True"><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,0.125,0.25" ViewportUnits="RelativeToBoundingBox" Viewbox="0,0,12,12" ViewboxUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Geometry="M0,12 V0 H12"><GeometryDrawing.Pen><Pen Brush="#405C5C64" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
 <Viewbox Stretch="Fill"><Grid Width="104" Height="50"><Path Data="{Binding CpuFill}" Fill="{Binding Accent, ElementName=Panel}" Opacity=".18"/><Path Data="{Binding CpuGraph}" Stroke="{Binding Accent, ElementName=Panel}" StrokeThickness="1.2"/></Grid></Viewbox></Grid></Border>
 <DockPanel><TextBlock DockPanel.Dock="Right" Text="0" FontSize="8" Foreground="#A1A1AA"/><TextBlock FontSize="8" Foreground="#A1A1AA" Text="{Binding HistoryLabel, ElementName=Panel}"/></DockPanel></StackPanel>
</StackPanel><StackPanel x:Name="GpuCard" Margin="4,0">
 <StackPanel Orientation="Horizontal"><Path Data="{StaticResource MetricGpuIcon}" Width="15" Height="13" Stretch="Uniform" Stroke="#BABAC2" StrokeThickness="1.2" VerticalAlignment="Center" AutomationProperties.Name="GPU"/><TextBlock Text="{Binding GpuText}" FontSize="14" FontWeight="SemiBold" Margin="5,0"/></StackPanel>
 <StackPanel x:Name="GpuLine"><TextBlock Text="100%" HorizontalAlignment="Right" FontSize="8" Foreground="#A1A1AA"/>
 <Border BorderThickness="1" BorderBrush="#55555B"><Grid Height="50" ClipToBounds="True"><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,0.125,0.25" ViewportUnits="RelativeToBoundingBox" Viewbox="0,0,12,12" ViewboxUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Geometry="M0,12 V0 H12"><GeometryDrawing.Pen><Pen Brush="#405C5C64" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
 <Viewbox Stretch="Fill"><Grid Width="104" Height="50"><Path Data="{Binding GpuFill}" Fill="{Binding Accent, ElementName=Panel}" Opacity=".18"/><Path Data="{Binding GpuGraph}" Stroke="{Binding Accent, ElementName=Panel}" StrokeThickness="1.2"/></Grid></Viewbox></Grid></Border>
 <DockPanel><TextBlock DockPanel.Dock="Right" Text="0" FontSize="8" Foreground="#A1A1AA"/><TextBlock FontSize="8" Foreground="#A1A1AA" Text="{Binding HistoryLabel, ElementName=Panel}"/></DockPanel></StackPanel>
</StackPanel><StackPanel x:Name="RamCard" Margin="4,0">
 <StackPanel Orientation="Horizontal"><Path Data="{StaticResource MetricRamIcon}" Width="15" Height="13" Stretch="Uniform" Stroke="#BABAC2" StrokeThickness="1.2" VerticalAlignment="Center" AutomationProperties.Name="RAM"/><TextBlock Text="{Binding RamText}" FontSize="14" FontWeight="SemiBold" Margin="5,0"/></StackPanel>
 <StackPanel x:Name="RamLine"><TextBlock Text="100%" HorizontalAlignment="Right" FontSize="8" Foreground="#A1A1AA"/>
 <Border BorderThickness="1" BorderBrush="#55555B"><Grid Height="50" ClipToBounds="True"><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,0.125,0.25" ViewportUnits="RelativeToBoundingBox" Viewbox="0,0,12,12" ViewboxUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Geometry="M0,12 V0 H12"><GeometryDrawing.Pen><Pen Brush="#405C5C64" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
 <Viewbox Stretch="Fill"><Grid Width="104" Height="50"><Path Data="{Binding RamFill}" Fill="{Binding Accent, ElementName=Panel}" Opacity=".18"/><Path Data="{Binding RamGraph}" Stroke="{Binding Accent, ElementName=Panel}" StrokeThickness="1.2"/></Grid></Viewbox></Grid></Border>
 <DockPanel><TextBlock DockPanel.Dock="Right" Text="0" FontSize="8" Foreground="#A1A1AA"/><TextBlock FontSize="8" Foreground="#A1A1AA" Text="{Binding HistoryLabel, ElementName=Panel}"/></DockPanel></StackPanel>
</StackPanel></UniformGrid></UserControl>