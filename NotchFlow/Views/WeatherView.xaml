<UserControl x:Class="NotchFlow.Views.WeatherView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NotchFlow.Controls">
 <Grid Margin="22,7,22,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="85"/><RowDefinition Height="36"/><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel><Button DockPanel.Dock="Right" Content="↻" Command="{Binding Refresh}" Padding="7,2" Margin="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="{Binding City}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
  <Grid Grid.Row="1"><StackPanel><TextBlock Text="{Binding Temperature}" FontSize="46" FontWeight="Light"/><TextBlock Text="{Binding FeelsLike}" Foreground="#A0A0A6" FontSize="11"/></StackPanel><StackPanel HorizontalAlignment="Right"><local:WeatherIcon Code="{Binding Code}" IsDay="{Binding IsDay}" Width="62" Height="58" HorizontalAlignment="Right"/><TextBlock Text="{Binding Conditions}" FontSize="11" Foreground="#C9CBD0"/></StackPanel></Grid>
  <UniformGrid Grid.Row="2" Columns="3" Margin="0,4,0,2"><TextBlock Text="{Binding Wind, StringFormat=Ветер {0}}" FontSize="11"/><TextBlock Text="{Binding Humidity, StringFormat=Влажн. {0}}" FontSize="11"/><TextBlock Text="{Binding Rain, StringFormat=Осадки {0}}" FontSize="11"/></UniformGrid>
  <ItemsControl Grid.Row="3" ItemsSource="{Binding Hours}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding Time}" FontSize="10" Foreground="#A0A0A6" HorizontalAlignment="Center"/><local:WeatherIcon Code="{Binding Code}" Width="30" Height="28"/><TextBlock Text="{Binding Temperature}" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="{Binding Rain}" FontSize="9" Foreground="#8FB5D3" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

 </Grid>
</UserControl>


