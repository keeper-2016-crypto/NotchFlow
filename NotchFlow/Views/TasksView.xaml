<UserControl x:Class="NotchFlow.Views.TasksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style TargetType="TextBox"><Setter Property="Background" Value="#1D1D20"/><Setter Property="Foreground" Value="#EFEDE8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7"/><Setter Property="CaretBrush" Value="White"/></Style></UserControl.Resources>
 <Grid Margin="22,7,22,18"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="36"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding TaskSummary}" FontSize="15" FontWeight="SemiBold"/>
  <DockPanel Grid.Row="1" IsEnabled="{Binding CanEdit}"><Button Content="+" DockPanel.Dock="Right" Width="30" Padding="0" Click="AddTask"/><TextBox Text="{Binding TaskDraft,UpdateSourceTrigger=PropertyChanged}" KeyDown="AddKey"/></DockPanel>
  <Grid Grid.Row="2" Margin="0,9,0,9"><TextBlock Text="Задач пока нет" Foreground="#929298" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NoTasks}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Tasks}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#19191C" CornerRadius="8" Margin="0,0,0,5" Padding="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
    <CheckBox IsChecked="{Binding IsCompleted,Mode=TwoWay}" VerticalAlignment="Center" Checked="CompletionChanged" Unchecked="CompletionChanged" Margin="0"/>
    <Grid Grid.Column="1"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="#797980"/></DataTrigger><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" KeyDown="EditKey"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></Grid>
    <Button Grid.Column="2" Content="✎" Click="EditTask" Padding="0" Margin="0" Background="Transparent"/><Button Grid.Column="3" Content="×" Click="RemoveTask" Padding="0" Margin="0" Background="Transparent"/>
   </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="3"><Button DockPanel.Dock="Right" Content="Сохранить" Click="Save" FontSize="10" Padding="7,3" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{Binding DisplayError}" FontSize="10" Foreground="#9D9DA5" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</UserControl>


