<Button Content="Сторонние компоненты" Tag="https://github.com/keeper-2016-crypto/NotchFlow/blob/main/NotchFlow/THIRD-PARTY-NOTICES.md" Click="OpenLinkClick" HorizontalAlignment="Left"/>
</StackPanel>
</ScrollViewer>
</TabItem>
</TabControl>
</DockPanel>
