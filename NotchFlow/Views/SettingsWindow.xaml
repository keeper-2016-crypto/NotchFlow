<Window x:Class="NotchFlow.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="/NotchFlow;component/Assets/NotchFlow.ico" Title="NotchFlow · Настройки" Width="730" Height="570" MinWidth="650" MinHeight="510" Background="#0B0B0C" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#202022"/><Setter Property="Foreground" Value="#EFEDE8"/><Setter Property="BorderBrush" Value="#39393C"/><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,5,0,10"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#EFEDE8"/><Setter Property="Margin" Value="0,6,0,14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="#202022" BorderBrush="#39393C" BorderThickness="1" CornerRadius="6"><ContentPresenter Margin="10,7,30,7" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/></Border><ToggleButton Background="Transparent" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Grid></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#202022" BorderBrush="#454548" BorderThickness="1" Padding="4" CornerRadius="6"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>

  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#B1B1B4"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Item" Background="Transparent" CornerRadius="6" Margin="0,2" Padding="12,11"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#202022"/><Setter Property="Foreground" Value="#EFEDE8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#19191B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="166"/><ColumnDefinition/></Grid.ColumnDefinitions><Border BorderBrush="#232325" BorderThickness="0,0,1,0" Padding="0,0,14,0"><StackPanel><TextBlock Text="NotchFlow" FontSize="19" FontWeight="SemiBold" Margin="12,2,0,24"/><TabPanel IsItemsHost="True"/></StackPanel></Border><ContentPresenter Grid.Column="1" Margin="26,0,0,0" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <DockPanel Margin="20"><StackPanel DockPanel.Dock="Bottom" Margin="180,16,0,0"><TextBlock x:Name="ErrorText" Foreground="#FFAAAA" TextWrapping="Wrap"/><Button x:Name="SaveButton" Content="Сохранить и применить" Click="SaveClick" HorizontalAlignment="Right" Padding="16,9"/></StackPanel>
 <TabControl TabStripPlacement="Left">
  <TabItem Header="Внешний вид"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,14,0"><TextBlock Text="НАСТРОЙКИ" Foreground="#78787D" FontSize="10"/><TextBlock Text="Внешний вид" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,24"/><CheckBox Content="Форма Notch — примыкание к верхней кромке" IsChecked="{Binding AttachToTop}" Margin="0,0,0,14"/><TextBlock Text="Background Effect"/>
<ComboBox SelectedValuePath="Content" SelectedValue="{Binding BackgroundEffect, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="VisualSettingChanged"><ComboBoxItem Content="Solid"/><ComboBoxItem Content="Album Gradient"/></ComboBox>
<TextBlock Text="Acrylic and Liquid Glass are unavailable in the current layered window. Existing glass selections use Solid." Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,12"/>
<TextBlock Text="Tint Intensity"/><Slider Minimum="0" Maximum="1" Value="{Binding TintIntensity, UpdateSourceTrigger=PropertyChanged}" ValueChanged="VisualSettingChanged" Margin="0,9,0,16"/>
<TextBlock Text="Border Glow"/><Slider Minimum="0" Maximum="1" Value="{Binding BorderGlow, UpdateSourceTrigger=PropertyChanged}" ValueChanged="VisualSettingChanged" Margin="0,9,0,16"/>
<TextBlock Text="Цвет поверхности"/><TextBox Text="{Binding CapsuleColor}"/><TextBlock Text="Непрозрачность"/><Slider Minimum="0.3" Maximum="1" Value="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}" ValueChanged="VisualSettingChanged" Margin="0,9,0,16"/><TextBlock Text="Размер острова"/><Slider Minimum="0.8" Maximum="1.8" Value="{Binding Scale}" Margin="0,9,0,16"/><TextBlock Text="Скругление раскрытой панели"/><Slider Minimum="8" Maximum="40" Value="{Binding CornerRadius}" Margin="0,9,0,16"/><CheckBox Content="Мягкая тень" IsChecked="{Binding Shadow}"/><CheckBox Content="Плавные анимации" IsChecked="{Binding Animations}"/><TextBlock Text="Длительность перехода, мс" Margin="0,8,0,0"/><Slider Minimum="150" Maximum="300" Value="{Binding AnimationMs}" Margin="0,9,0,10"/><Button Content="Восстановить оформление по образцу" Click="ResetAppearanceClick" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Media Player"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,14,0">
   <TextBlock Text="Media Player" FontSize="26" Margin="0,0,0,18"/>
   <TextBlock Text="Media Visualizer"/>
   <ComboBox SelectedValuePath="Content" SelectedValue="{Binding MediaVisualizer, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="VisualSettingChanged"><ComboBoxItem Content="Classic"/><ComboBoxItem Content="Album Glow"/><ComboBoxItem Content="Breathing Island"/><ComboBoxItem Content="Equalizer"/><ComboBoxItem Content="Neon Ribbon"/></ComboBox>
<TextBlock Text="Neon Ribbon" FontSize="18" Margin="0,18,0,10"/><TextBlock Text="Color Mode"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding RibbonColorMode, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="VisualSettingChanged"><ComboBoxItem Content="Pink / Purple / Blue"/><ComboBoxItem Content="Album Colors"/><ComboBoxItem Content="Custom Color"/></ComboBox><TextBlock Text="Glow Intensity"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding RibbonGlow, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="VisualSettingChanged"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/></ComboBox><TextBlock Text="Audio Sensitivity"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding RibbonSensitivity, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="VisualSettingChanged"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Normal"/><ComboBoxItem Content="High"/></ComboBox><TextBlock Text="Ribbon Thickness"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding RibbonThickness, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="VisualSettingChanged"><ComboBoxItem Content="Thin"/><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Bold"/></ComboBox><TextBlock Text="Animation"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding RibbonAnimation, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="VisualSettingChanged"><ComboBoxItem Content="Audio Reactive"/><ComboBoxItem Content="Static"/><ComboBoxItem Content="Disabled"/></ComboBox><TextBlock Text="Custom Color uses Custom HEX above. Audio Reactive requires system audio analysis." Foreground="#A1A1AA" TextWrapping="Wrap"/>   <TextBlock Text="Accent Color"/>
   <ComboBox SelectedValuePath="Content" SelectedValue="{Binding AccentMode, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="VisualSettingChanged"><ComboBoxItem Content="Default White"/><ComboBoxItem Content="Red"/><ComboBoxItem Content="Purple"/><ComboBoxItem Content="Blue"/><ComboBoxItem Content="Cyan"/><ComboBoxItem Content="Green"/><ComboBoxItem Content="Pink"/><ComboBoxItem Content="Custom HEX"/><ComboBoxItem Content="Dynamic Album Colors"/></ComboBox>
   <TextBlock Text="Custom HEX"/>
   <TextBox Text="{Binding CustomAccentColor, UpdateSourceTrigger=PropertyChanged}" TextChanged="VisualSettingChanged"/>
   <TextBlock Text="Album Art Style"/>
   <ComboBox SelectedValuePath="Content" SelectedValue="{Binding AlbumArtStyle, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="VisualSettingChanged"><ComboBoxItem Content="Clean"/><ComboBoxItem Content="Blurred"/><ComboBoxItem Content="Gradient"/><ComboBoxItem Content="Blur + Gradient"/></ComboBox>
   <CheckBox Content="Enable system audio analysis" IsChecked="{Binding AudioAnalysisEnabled, UpdateSourceTrigger=PropertyChanged}" Click="VisualSettingChanged"/>
<TextBlock Text="WASAPI Loopback analyses all applications on the default output, including notifications. It does not isolate the selected media app. Audio stays in memory." Foreground="#A1A1AA" TextWrapping="Wrap"/>
<TextBlock Text="Sensitivity" Margin="0,12,0,0"/>
<Slider Minimum="0.25" Maximum="4" Value="{Binding AudioSensitivity, UpdateSourceTrigger=PropertyChanged}" ValueChanged="VisualSettingChanged"/>
<TextBlock Text="With audio analysis off or unavailable, the new visualizers stay still." Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Animation"><StackPanel>
   <TextBlock Text="Animation" FontSize="26" Margin="0,0,0,18"/>
   <TextBlock Text="Animation Intensity"/>
   <ComboBox SelectedValuePath="Content" SelectedValue="{Binding AnimationIntensity, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="VisualSettingChanged"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/></ComboBox>
   <CheckBox Content="Reduce Motion" IsChecked="{Binding ReduceMotion, UpdateSourceTrigger=PropertyChanged}" Click="VisualSettingChanged"/>
  </StackPanel></TabItem>
  <TabItem Header="Положение"><StackPanel Margin="0,0,14,0"><TextBlock Text="НАСТРОЙКИ" Foreground="#78787D" FontSize="10"/><TextBlock Text="Положение" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,24"/><TextBlock Text="Монитор"/><ComboBox x:Name="MonitorBox" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Monitor}"/><TextBlock Text="Привязка"/><ComboBox x:Name="PositionBox" SelectedValuePath="Tag" SelectedValue="{Binding Position}"><ComboBoxItem Content="Верхний центр" Tag="Center"/><ComboBoxItem Content="Верхний левый угол" Tag="Left"/><ComboBoxItem Content="Верхний правый угол" Tag="Right"/></ComboBox><TextBlock Text="Смещение X, DIP"/><TextBox Text="{Binding OffsetX, ValidatesOnExceptions=True}"/><TextBlock Text="Смещение Y, DIP (для плавающего острова)"/><TextBox Text="{Binding OffsetY, ValidatesOnExceptions=True}"/><TextBlock Text="Если выбранный монитор отключён, используется основной." Foreground="#909095" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></TabItem>
  <TabItem Header="Модули"><StackPanel><TextBlock Text="НАСТРОЙКИ" Foreground="#78787D" FontSize="10"/><TextBlock Text="Модули" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,24"/><CheckBox Content="Медиаплеер Windows" IsChecked="{Binding MediaEnabled}"/><CheckBox Content="Уведомления громкости" IsChecked="{Binding VolumeEnabled}"/><TextBlock Text="Системная громкость доступна внизу музыкальной панели. Обложка и композиция приходят из текущей сессии Windows." Foreground="#909095" TextWrapping="Wrap" Margin="0,18,12,0"/></StackPanel></TabItem>
  <TabItem Header="Погода"><StackPanel><TextBlock Text="Погода" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,24"/><TextBlock Text="Город в России"/><TextBox Text="{Binding WeatherCity}"/><TextBlock Text="По умолчанию: Пятигорск, Europe/Moscow. После сохранения город определяется через Open-Meteo. Прогноз обновляется раз в 20 минут после первого открытия Weather; доступно ручное обновление." TextWrapping="Wrap" Foreground="#909095" Margin="0,16,12,0"/></StackPanel></TabItem><TabItem Header="Поведение"><StackPanel><TextBlock Text="НАСТРОЙКИ" Foreground="#78787D" FontSize="10"/><TextBlock Text="Поведение" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,24"/><CheckBox Content="Поверх остальных окон" IsChecked="{Binding AlwaysOnTop}"/><CheckBox Content="Сворачивать при уходе курсора" IsChecked="{Binding CollapseOnLeave}"/><CheckBox Content="Запускать свёрнутым" IsChecked="{Binding StartCollapsed}"/><CheckBox Content="Запускать с Windows" IsChecked="{Binding AutoStart}"/><TextBlock Text="Наведение: 150 мс. Сворачивание: через 380 мс после ухода курсора. Закрепление сохраняет панель раскрытой до выхода." Foreground="#909095" TextWrapping="Wrap" Margin="0,18,12,0"/></StackPanel></TabItem>
  <TabItem Header="О приложении"><StackPanel><TextBlock Text="NotchFlow" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,24"/><TextBlock Text="Нативный остров для Windows 11"/><TextBlock Text="Музыка, погода, заметки и задачи в компактной панели." Foreground="#909095" TextWrapping="Wrap" Margin="0,18,12,0"/><TextBlock Text="Запланировано: таймер, CPU/RAM, батарея, сеть, очередь уведомлений, горячая клавиша и автоматическое скрытие в полноэкранных приложениях." Foreground="#909095" TextWrapping="Wrap" Margin="0,18,12,0"/></StackPanel></TabItem>
 </TabControl></DockPanel>
</Window>




