<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NotchFlow</AssemblyName><RootNamespace>NotchFlow</RootNamespace><Product>NotchFlow</Product><Title>NotchFlow</Title><ApplicationIcon>Assets\NotchFlow.ico</ApplicationIcon>
    <Version>0.3.9</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion><FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefineConstants Condition="'$(LocalUpdateTest)' == 'true'">$(DefineConstants);LOCAL_UPDATE_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NAudio.Wasapi" Version="2.2.1" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets\UpdatePublicKey.pem" LogicalName="NotchFlow.UpdatePublicKey.pem" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\Fonts\*.ttf" /><Resource Include="Assets\NotchFlow.ico" /></ItemGroup>
</Project>



